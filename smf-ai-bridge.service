[Unit]
Description=SMF Works AI Team Message Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# NOTE: Update these paths to match your installation
ExecStart=/usr/bin/env node /opt/smf-ai-bridge/server.js
WorkingDirectory=/opt/smf-ai-bridge
Restart=always
RestartSec=3

# Environment configuration
Environment=PORT=8700
Environment=HOST=127.0.0.1
Environment=BRIDGE_DATA_DIR=/opt/smf-ai-bridge/data
Environment=LOG_LEVEL=info
Environment=MAX_SSE_CLIENTS=50

# Graceful shutdown
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=default.target