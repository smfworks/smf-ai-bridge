{
  "name": "smf-ai-bridge",
  "version": "1.0.0",
  "description": "On-machine communication bridge for inter-AI messaging between OpenClaw and Hermes agents",
  "main": "server.js",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:verbose": "node --test --test-reporter=spec test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "example:chat": "bash examples/two-agents-chat.sh",
    "example:poll": "bash examples/heartbeat-unread.sh"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "express": "^5.2.1"
  }
}
