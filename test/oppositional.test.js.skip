// ─── 7. SSE Client Limit Race Condition ────────────────────────────────────────

describe('SSE stream endpoint', () => {
  it('returns 503 when SSE client limit is reached', async () => {
    const dataDir = mkdtempSync(join(tmpdir(), 'bridge-sse-'));
    const db = initDatabase(dataDir);
    seedDefaultAgents(db);
    const sse = new SSEManager(1); // Only 1 client allowed
    const appConfig = { ...config, dataDir, maxSseClients: 1, defaultLimit: 100, maxQueryLimit: 500, version: '1.0.0' };
    const app = createApp(db, sse, appConfig);
    const server = http.createServer(app);
    server.listen(0);
    const port = server.address().port;
    const baseUrl = `http://127.0.0.1:${port}`;

    // Manually add a client to fill the SSE manager to capacity
    sse.add({ write: () => {}, end: () => {} });

    // Now the next request should get 503
    const res = await fetch(`${baseUrl}/api/stream`);
    assert.strictEqual(res.status, 503);
    const body = await res.json();
    assert.ok(body.error.includes('too many SSE clients'));

    server.close();
    db.close();
    rmSync(dataDir, { recursive: true, force: true });
  });

  it('accepts SSE connection when under limit', async () => {
    const dataDir = mkdtempSync(join(tmpdir(), 'bridge-sse-ok-'));
    const db = initDatabase(dataDir);
    seedDefaultAgents(db);
    const sse = new SSEManager(50);
    const appConfig = { ...config, dataDir, maxSseClients: 50, defaultLimit: 100, maxQueryLimit: 500, version: '1.0.0' };
    const app = createApp(db, sse, appConfig);
    const server = http.createServer(app);
    server.listen(0);
    const port = server.address().port;
    const baseUrl = `http://127.0.0.1:${port}`;

    // Use http.get to have more control over the connection lifecycle
    const { default: http } = await import('node:http');
    
    await new Promise((resolve, reject) => {
      const req = http.get(`${baseUrl}/api/stream`, (res) => {
        assert.strictEqual(res.statusCode, 200);
        assert.strictEqual(res.headers['content-type'], 'text/event-stream');
        // Read the initial data
        res.on('data', () => {
          // Got data — connection is working, close it
          res.destroy();
          req.destroy();
          resolve();
        });
      });
      req.on('error', (err) => {
        // If the error is from destroying, that's fine
        if (err.code === 'ERR_STREAM_PREMATURE_CLOSE' || err.message.includes('aborted')) {
          resolve();
        } else {
          reject(err);
        }
      });
    });

    server.close();
    db.close();
    rmSync(dataDir, { recursive: true, force: true });
  });
});

// ─── 8. Dead Code / Constant Validation ───────────────────────────────────────

describe('LIMITS constants are properly used', () => {
  it('LIMITS object contains all expected limits', () => {
    assert.ok(typeof LIMITS.MAX_STRING_LENGTH === 'number');
    assert.ok(typeof LIMITS.MAX_BODY_LENGTH === 'number');
    assert.ok(typeof LIMITS.MAX_MESSAGE_IDS === 'number');
    assert.ok(typeof LIMITS.MAX_SSE_CLIENTS === 'number');
    assert.ok(typeof LIMITS.DEFAULT_QUERY_LIMIT === 'number');
    assert.ok(typeof LIMITS.MAX_QUERY_LIMIT === 'number');
    assert.strictEqual(LIMITS.MAX_STRING_LENGTH, 200);
    assert.strictEqual(LIMITS.MAX_BODY_LENGTH, 100000);
    assert.strictEqual(LIMITS.MAX_MESSAGE_IDS, 1000);
  });

  it('body length limit uses LIMITS constant', async () => {
    const env = makeTestEnv();
    const res = await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry', body: 'a'.repeat(LIMITS.MAX_BODY_LENGTH + 1),
    });
    assert.strictEqual(res.status, 400);
    assert.ok(res.body.error.includes(String(LIMITS.MAX_BODY_LENGTH)));
    cleanup(env);
  });

  it('messageIds limit uses LIMITS constant', async () => {
    const env = makeTestEnv();
    const hugeArray = new Array(LIMITS.MAX_MESSAGE_IDS + 1).fill('test-id');
    const res = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry', messageIds: hugeArray,
    });
    assert.strictEqual(res.status, 400);
    assert.ok(res.body.error.includes(String(LIMITS.MAX_MESSAGE_IDS)));
    cleanup(env);
  });
});

// ─── 9. Concurrent Operations ─────────────────────────────────────────────────

describe('Concurrent operations', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('handles concurrent message sends correctly', async () => {
    const promises = [];
    for (let i = 0; i < 20; i++) {
      promises.push(envRequest(env, 'POST', '/api/send', {
        from: 'aiona', to: 'harry', body: `Concurrent ${i}`,
      }));
    }
    const results = await Promise.all(promises);
    assert.ok(results.every(r => r.status === 201));

    const inbox = await envRequest(env, 'GET', '/api/inbox/harry');
    assert.strictEqual(inbox.body.count, 20);
  });

  it('handles concurrent agent registrations with unique names', async () => {
    const promises = [];
    for (let i = 0; i < 10; i++) {
      promises.push(envRequest(env, 'POST', '/api/agents', {
        name: `concurrent-agent-${i}`, platform: 'hermes',
      }));
    }
    const results = await Promise.all(promises);
    assert.ok(results.every(r => r.status === 201));
  });

  it('handles concurrent heartbeats without interference', async () => {
    const promises = [];
    for (let i = 0; i < 5; i++) {
      promises.push(envRequest(env, 'POST', '/api/heartbeat', { name: 'aiona' }));
    }
    const results = await Promise.all(promises);
    assert.ok(results.every(r => r.status === 200));
  });

  it('handles sequential read operations on same messages correctly', async () => {
    const sendRes = await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry', body: 'Concurrent read test',
    });
    const msgId = sendRes.body.message.id;

    // First read marks it as read
    const r1 = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry', messageIds: [msgId],
    });
    assert.strictEqual(r1.body.updated, 1);

    // Second read on same message should mark 0 (already read)
    const r2 = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry', messageIds: [msgId],
    });
    assert.strictEqual(r2.body.updated, 0);
  });
});

// ─── 10. Boundary Conditions ──────────────────────────────────────────────────

describe('Boundary conditions', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('accepts body exactly at MAX_BODY_LENGTH', async () => {
    const res = await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry', body: 'a'.repeat(LIMITS.MAX_BODY_LENGTH),
    });
    assert.strictEqual(res.status, 201);
  });

  it('accepts string at exactly 200 chars', async () => {
    const res = await envRequest(env, 'POST', '/api/agents', {
      name: 'a'.repeat(200), platform: 'hermes',
    });
    assert.strictEqual(res.status, 201);
  });

  it('accepts limit at exactly MAX_QUERY_LIMIT', async () => {
    const res = await envRequest(env, 'GET', `/api/inbox/harry?limit=${LIMITS.MAX_QUERY_LIMIT}`);
    assert.strictEqual(res.status, 200);
  });

  it('rejects limit at MAX_QUERY_LIMIT + 1', async () => {
    const res = await envRequest(env, 'GET', `/api/inbox/harry?limit=${LIMITS.MAX_QUERY_LIMIT + 1}`);
    assert.strictEqual(res.status, 400);
  });

  it('accepts limit of 1', async () => {
    await envRequest(env, 'POST', '/api/send', { from: 'aiona', to: 'harry', body: 'A' });
    await envRequest(env, 'POST', '/api/send', { from: 'aiona', to: 'harry', body: 'B' });
    const res = await envRequest(env, 'GET', '/api/inbox/harry?limit=1');
    assert.strictEqual(res.status, 200);
    assert.strictEqual(res.body.count, 1);
  });

  it('accepts messageIds array of exactly MAX_MESSAGE_IDS', async () => {
    const ids = new Array(LIMITS.MAX_MESSAGE_IDS).fill('nonexistent-id');
    const res = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry', messageIds: ids,
    });
    assert.strictEqual(res.status, 200);
  });

  it('rejects messageIds array of MAX_MESSAGE_IDS + 1', async () => {
    const ids = new Array(LIMITS.MAX_MESSAGE_IDS + 1).fill('nonexistent-id');
    const res = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry', messageIds: ids,
    });
    assert.strictEqual(res.status, 400);
  });

  it('accepts gatewayPort at exactly 65535', async () => {
    const res = await envRequest(env, 'POST', '/api/agents', {
      name: 'test-port', platform: 'hermes', gatewayPort: 65535,
    });
    assert.strictEqual(res.status, 201);
  });

  it('accepts gatewayPort at exactly 1', async () => {
    const res = await envRequest(env, 'POST', '/api/agents', {
      name: 'test-port2', platform: 'hermes', gatewayPort: 1,
    });
    assert.strictEqual(res.status, 201);
  });
});

// ─── 11. Error Path Coverage ──────────────────────────────────────────────────

describe('Error path coverage', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('POST /api/agents with non-object body returns 400', async () => {
    const res = await envRequest(env, 'POST', '/api/agents', null, '"not-an-object"');
    assert.strictEqual(res.status, 400);
  });

  it('POST /api/send with non-object body returns 400', async () => {
    const res = await envRequest(env, 'POST', '/api/send', null, '"just-a-string"');
    assert.strictEqual(res.status, 400);
  });

  it('POST /api/read with non-object body returns 400', async () => {
    const res = await envRequest(env, 'POST', '/api/read', null, '"just-a-string"');
    assert.strictEqual(res.status, 400);
  });

  it('POST /api/heartbeat with non-object body returns 400', async () => {
    const res = await envRequest(env, 'POST', '/api/heartbeat', null, '"just-a-string"');
    assert.strictEqual(res.status, 400);
  });

  it('POST /api/read with messageIds containing non-string values skips them', async () => {
    const sendRes = await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry', body: 'test',
    });
    const res = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry',
      messageIds: [sendRes.body.message.id, 12345, null, {}, [], true],
    });
    assert.strictEqual(res.status, 200);
    assert.strictEqual(res.body.updated, 1);
  });

  it('POST /api/read with messageIds containing very long string skips it', async () => {
    const res = await envRequest(env, 'POST', '/api/read', {
      agent: 'harry',
      messageIds: ['a'.repeat(201)],
    });
    assert.strictEqual(res.status, 200);
    assert.strictEqual(res.body.updated, 0);
  });

  it('GET /api/inbox with empty agent param', async () => {
    const res = await envRequest(env, 'GET', '/api/inbox/');
    assert.strictEqual(res.status, 404); // Express treats empty param as no route match
  });

  it('GET /api/thread with empty threadId param', async () => {
    const res = await envRequest(env, 'GET', '/api/thread/');
    assert.strictEqual(res.status, 404);
  });
});

// ─── 12. Dashboard XSS Content Verification ─────────────────────────────────────

describe('Dashboard content security', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('dashboard does not inject raw user data into HTML at render time', async () => {
    // The dashboard is a static HTML page that loads data via fetch/JS
    // Verify the HTML template itself doesn't contain any user-controllable inline data
    const res = await envRequest(env, 'GET', '/');
    const html = res.raw;

    // Check that the dashboard uses escapeHtml before insertAdjacentHTML
    assert.ok(html.includes('escapeHtml'));

    // Check that the addMessage function escapes all interpolated values
    const addMessageMatch = html.match(/function addMessage[\s\S]*?\n  \}/);
    assert.ok(addMessageMatch, 'addMessage function should exist');
    assert.ok(addMessageMatch[0].includes('escapeHtml'), 'addMessage should call escapeHtml');

    // Check that the agent list rendering also escapes
    const agentRenderMatch = html.match(/agentList\.innerHTML[\s\S]*?\.join\(''\)/);
    assert.ok(agentRenderMatch, 'agent list rendering should exist');
    assert.ok(agentRenderMatch[0].includes('escapeHtml'), 'agent list should use escapeHtml');
  });
});

// ─── 13. Path Traversal Prevention ─────────────────────────────────────────────

describe('Path traversal prevention', () => {
  it('initDatabase resolves relative paths correctly', () => {
    const dataDir = mkdtempSync(join(tmpdir(), 'bridge-traversal-'));
    const db = initDatabase(dataDir);
    assert.ok(db);
    // Verify we can use the DB
    const count = db.prepare('SELECT COUNT(*) as count FROM agents').get().count;
    assert.strictEqual(count, 0);
    db.close();
    rmSync(dataDir, { recursive: true, force: true });
  });

  it('initDatabase creates nested directories if needed', () => {
    const baseDir = mkdtempSync(join(tmpdir(), 'bridge-nested-'));
    const nestedDir = join(baseDir, 'deeply', 'nested', 'path');
    const db = initDatabase(nestedDir);
    assert.ok(db);
    db.close();
    rmSync(baseDir, { recursive: true, force: true });
  });
});

