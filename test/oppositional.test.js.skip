// ─── 15. Inbox Query Correctness ───────────────────────────────────────────────

describe('Inbox query edge cases', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('inbox for agent with special characters in name', async () => {
    // Register agent with hyphen
    await envRequest(env, 'POST', '/api/agents', {
      name: 'agent-with-hyphen', platform: 'hermes',
    });
    await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'agent-with-hyphen', body: 'Hello hyphen',
    });
    const res = await envRequest(env, 'GET', '/api/inbox/agent-with-hyphen');
    assert.strictEqual(res.status, 200);
    assert.strictEqual(res.body.count, 1);
  });

  it('inbox with limit=0 is rejected', async () => {
    const res = await envRequest(env, 'GET', '/api/inbox/harry?limit=0');
    assert.strictEqual(res.status, 400);
  });

  it('inbox with negative limit is rejected', async () => {
    const res = await envRequest(env, 'GET', '/api/inbox/harry?limit=-5');
    assert.strictEqual(res.status, 400);
  });

  it('inbox returns broadcast messages for any agent', async () => {
    await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'everyone', body: 'Broadcast!', type: 'broadcast',
    });
    const res = await envRequest(env, 'GET', '/api/inbox/zayn');
    assert.ok(res.body.count >= 1);
    assert.ok(res.body.messages.some(m => m.type === 'broadcast'));
  });

  it('inbox returns team messages for any agent', async () => {
    await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'team', body: 'Team update',
    });
    const res = await envRequest(env, 'GET', '/api/inbox/zayn');
    assert.ok(res.body.count >= 1);
    assert.ok(res.body.messages.some(m => m.toAgent === 'team'));
  });
});

// ─── 16. Unhandled Rejection / Exception Handlers ───────────────────────────────

describe('Process error handlers', () => {
  it('unhandledRejection handler is registered when startServer is called', () => {
    // We can't call startServer in tests (it starts listening), but we can verify
    // the handlers exist by checking the process listener count
    // This is a smoke test — the actual handlers are registered in startServer
    const initialCount = process.listenerCount('unhandledRejection');
    // The handlers are only registered in startServer, which we don't call in tests
    // This test documents the expectation
    assert.ok(initialCount >= 0);
  });
});