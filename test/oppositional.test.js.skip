// ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

// ─── 1. XSS in Dashboard HTML ──────────────────────────────────────────────────

describe('XSS prevention in dashboard', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('escapes HTML in message body, subject, fromAgent, toAgent', async () => {
    // Send a message with XSS payload
    const xssPayload = '<script>alert("xss")</script><img src=x onerror=alert(1)>';
    await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry',
      body: xssPayload,
      subject: '<script>alert("subj-xss")</script>',
    });

    // Fetch the dashboard HTML
    const res = await envRequest(env, 'GET', '/');
    const html = res.raw;

    // The raw XSS payload should NOT appear in the HTML
    // (the dashboard fetches messages client-side, so we check the JS code has escapeHtml)
    assert.ok(html.includes('escapeHtml'), 'Dashboard should include escapeHtml function');
    assert.ok(!html.includes('insertAdjacentHTML(\'afterbegin\',\n      \'<div class="msg"><div class="header">\'' +
      '\n        \'<span class="from">\' + (d.fromAgent||\'?\')'), 'Dashboard should not use raw unescaped values in insertAdjacentHTML');
  });

  it('dashboard HTML contains escapeHtml function definition', async () => {
    const res = await envRequest(env, 'GET', '/');
    assert.ok(res.raw.includes('function escapeHtml'));
    assert.ok(res.raw.includes('createTextNode'));
  });

  it('escapeHtml function escapes all dangerous characters', () => {
    assert.strictEqual(escapeHtml('<script>'), '&lt;script&gt;');
    assert.strictEqual(escapeHtml('"'), '&quot;');
    assert.strictEqual(escapeHtml("'"), '&#39;');
    assert.strictEqual(escapeHtml('&'), '&amp;');
    assert.strictEqual(escapeHtml(null), '');
    assert.strictEqual(escapeHtml(undefined), '');
  });
});

// ─── 2. Prototype Pollution Prevention ────────────────────────────────────────

describe('Prototype pollution prevention', () => {
  let env;
  beforeEach(() => { env = makeTestEnv(); });
  afterEach(() => cleanup(env));

  it('safeBody strips __proto__ key from request body', () => {
    // Object.keys won't include __proto__ set via literal, so use a Map-like approach
    const body = {};
    Object.defineProperty(body, '__proto__', { value: { polluted: true }, enumerable: true, configurable: true, writable: true });
    body.name = 'test';
    const fakeReq = { body };
    const result = safeBody(fakeReq);
    assert.ok(!('__proto__' in result && Object.prototype.hasOwnProperty.call(result, '__proto__')));
    assert.strictEqual(result.name, 'test');
  });

  it('safeBody strips constructor key from request body', () => {
    const body = Object.create(null);
    body.constructor = { prototype: { polluted: true } };
    body.name = 'test';
    const fakeReq = { body };
    const result = safeBody(fakeReq);
    assert.ok(!('constructor' in result));
    assert.strictEqual(result.name, 'test');
  });

  it('safeBody strips prototype from request body', () => {
    const fakeReq = { body: { prototype: { polluted: true }, name: 'test' } };
    const result = safeBody(fakeReq);
    assert.ok(!('prototype' in result));
    assert.strictEqual(result.name, 'test');
  });

  it('safeBody handles null body', () => {
    const fakeReq = { body: null };
    const result = safeBody(fakeReq);
    assert.deepStrictEqual(result, {});
  });

  it('safeBody handles undefined body', () => {
    const fakeReq = {};
    const result = safeBody(fakeReq);
    assert.deepStrictEqual(result, {});
  });

  it('safeBody handles array body', () => {
    const fakeReq = { body: [1, 2, 3] };
    const result = safeBody(fakeReq);
    assert.deepStrictEqual(result, {});
  });

  it('POST /api/agents with __proto__ in body does not pollute Object prototype', async () => {
    await envRequest(env, 'POST', '/api/agents', {
      name: 'test-pp',
      platform: 'hermes',
      __proto__: { polluted: true },
    });
    // Object.prototype should not have 'polluted'
    assert.strictEqual(Object.prototype.polluted, undefined);
  });

  it('POST /api/send with constructor in body does not pollute', async () => {
    await envRequest(env, 'POST', '/api/send', {
      from: 'aiona', to: 'harry', body: 'test',
      constructor: { prototype: { polluted: true } },
    });
    assert.strictEqual(Object.prototype.polluted, undefined);
  });
});

// ─── 3. SSEManager Broadcast Race Condition Fix ───────────────────────────────

describe('SSEManager broadcast safety', () => {
  it('correctly handles mixed live/dead clients without index corruption', () => {
    const sse = new SSEManager(100);
    let received = [];
    const live1 = { write: (p) => { received.push(['live1', p]); }, end: () => {} };
    const dead1 = { write: () => { throw new Error('closed'); }, end: () => {} };
    const live2 = { write: (p) => { received.push(['live2', p]); }, end: () => {} };
    const dead2 = { write: () => { throw new Error('closed'); }, end: () => {} };
    const live3 = { write: (p) => { received.push(['live3', p]); }, end: () => {} };

    sse.add(live1);
    sse.add(dead1);
    sse.add(live2);
    sse.add(dead2);
    sse.add(live3);

    assert.strictEqual(sse.count, 5);

    sse.broadcast('test', { hello: 'world' });

    // All 3 live clients should have received the message
    assert.strictEqual(received.length, 3);
    assert.ok(received.every(r => r[1].includes('event: test')));

    // Dead clients should be removed
    assert.strictEqual(sse.count, 3);
    assert.strictEqual(sse.clients[0], live1);
    assert.strictEqual(sse.clients[1], live2);
    assert.strictEqual(sse.clients[2], live3);

    // Second broadcast should only go to live clients
    received = [];
    sse.broadcast('test2', { foo: 'bar' });
    assert.strictEqual(received.length, 3);
  });

  it('broadcast with all dead clients cleans up properly', () => {
    const sse = new SSEManager(100);
    sse.add({ write: () => { throw new Error('dead'); }, end: () => {} });
    sse.add({ write: () => { throw new Error('dead'); }, end: () => {} });
    assert.strictEqual(sse.count, 2);
    sse.broadcast('test', { data: 1 });
    assert.strictEqual(sse.count, 0);
  });

  it('broadcast with no clients is a no-op', () => {
    const sse = new SSEManager(100);
    sse.broadcast('test', { data: 1 });
    assert.strictEqual(sse.count, 0);
    // seq should still increment
    assert.strictEqual(sse.seq, 0); // no broadcast happens if no clients
  });
});

// ─── 4. Config Validation at Startup ──────────────────────────────────────────

describe('parseConfig validates environment variables', () => {
  it('accepts valid config', () => {
    const cfg = parseConfig({ PORT: '9000', HOST: '0.0.0.0', LOG_LEVEL: 'debug' });
    assert.strictEqual(cfg.port, 9000);
    assert.strictEqual(cfg.host, '0.0.0.0');
    assert.strictEqual(cfg.logLevel, 'debug');
  });

  it('uses defaults when env not set', () => {
    const cfg = parseConfig({});
    assert.strictEqual(cfg.port, 8700);
    assert.strictEqual(cfg.host, '127.0.0.1');
    assert.strictEqual(cfg.logLevel, 'info');
    assert.strictEqual(cfg.maxSseClients, 50);
  });

  it('rejects invalid PORT (NaN)', () => {
    assert.throws(() => parseConfig({ PORT: 'abc' }), /Invalid PORT/);
  });

  it('rejects PORT out of range (0)', () => {
    assert.throws(() => parseConfig({ PORT: '0' }), /Invalid PORT/);
  });

  it('rejects PORT out of range (65536)', () => {
    assert.throws(() => parseConfig({ PORT: '65536' }), /Invalid PORT/);
  });

  it('rejects invalid LOG_LEVEL', () => {
    assert.throws(() => parseConfig({ LOG_LEVEL: 'verbose' }), /Invalid LOG_LEVEL/);
  });

  it('rejects invalid MAX_SSE_CLIENTS', () => {
    assert.throws(() => parseConfig({ MAX_SSE_CLIENTS: '0' }), /Invalid MAX_SSE_CLIENTS/);
    assert.throws(() => parseConfig({ MAX_SSE_CLIENTS: 'abc' }), /Invalid MAX_SSE_CLIENTS/);
  });

  it('rejects invalid DEFAULT_QUERY_LIMIT', () => {
    assert.throws(() => parseConfig({ DEFAULT_QUERY_LIMIT: '0' }), /Invalid DEFAULT_QUERY_LIMIT/);
    assert.throws(() => parseConfig({ DEFAULT_QUERY_LIMIT: 'xyz' }), /Invalid DEFAULT_QUERY_LIMIT/);
  });

  it('rejects DEFAULT_QUERY_LIMIT > MAX_QUERY_LIMIT', () => {
    assert.throws(
      () => parseConfig({ DEFAULT_QUERY_LIMIT: '500', MAX_QUERY_LIMIT: '100' }),
      /cannot exceed/
    );
  });

  it('rejects invalid MAX_QUERY_LIMIT', () => {
    assert.throws(() => parseConfig({ MAX_QUERY_LIMIT: '-1' }), /Invalid MAX_QUERY_LIMIT/);
  });
});

// ─── 5. validateInteger rejects trailing garbage ─────────────────────────────

describe('validateInteger strict parsing', () => {
  it('rejects strings with trailing alphabetic characters', () => {
    const r = validateInteger('50abc', 1, 100, 'limit');
    assert.ok(!r.valid);
    assert.ok(r.error.includes('integer'));
  });

  it('rejects strings with leading/trailing whitespace and junk', () => {
    assert.ok(!validateInteger('  50xyz  ', 1, 100, 'limit').valid);
  });

  it('accepts clean integer strings', () => {
    assert.ok(validateInteger('50', 1, 100, 'limit').valid);
    assert.ok(validateInteger(' 50 ', 1, 100, 'limit').valid);
  });

  it('accepts integer numbers', () => {
    assert.ok(validateInteger(50, 1, 100, 'limit').valid);
  });

  it('rejects floating point numbers', () => {
    assert.ok(!validateInteger(50.5, 1, 100, 'limit').valid);
  });

  it('rejects hex strings', () => {
    assert.ok(!validateInteger('0x10', 1, 100, 'limit').valid);
  });

  it('rejects negative numbers with -', () => {
    assert.ok(!validateInteger('-5', 1, 100, 'limit').valid);
  });
});

