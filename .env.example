# SMF AI Bridge — environment reference
#
# The server reads process.env only. `npm start` does NOT load this file
# (there is no dotenv dependency). Copy values into your shell or into
# smf-ai-bridge.service. Defaults already work for a local quickstart.
#
#   export PORT=8700
#   npm start

# Port the bridge listens on
PORT=8700

# Bind address (127.0.0.1 = localhost only; 0.0.0.0 = all interfaces)
HOST=127.0.0.1

# Directory for the SQLite database (bridge.db)
BRIDGE_DATA_DIR=./data

# Maximum request body size
BODY_LIMIT=1mb

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Maximum concurrent SSE (dashboard /api/stream) connections
MAX_SSE_CLIENTS=50

# Default limit for history/inbox queries
DEFAULT_QUERY_LIMIT=100

# Maximum limit for history/inbox queries
MAX_QUERY_LIMIT=500
