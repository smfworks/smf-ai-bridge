# SMF AI Bridge — Environment Configuration
# Copy this file to .env and adjust as needed

# Port the bridge listens on
PORT=8700

# Bind address (use 0.0.0.0 for network access; 127.0.0.1 for localhost only)
HOST=127.0.0.1

# Directory for the SQLite database
BRIDGE_DATA_DIR=./data

# Maximum request body size
BODY_LIMIT=1mb

# Log level: error, warn, info, debug
LOG_LEVEL=info

# Maximum concurrent SSE (Server-Sent Events) connections
MAX_SSE_CLIENTS=50

# Default limit for history/inbox queries
DEFAULT_QUERY_LIMIT=100

# Maximum limit for history/inbox queries
MAX_QUERY_LIMIT=500